# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional usage analytics for the local app. Leave blank and nothing is sent.
# The key is a PostHog project key (phc_...), which can only send events.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Hosted app only (CLOUD-PLAN.md). The local app does not need these.
# The development Supabase project: Project Settings > API Keys. Used by npm run check-rls.
# The publishable key is safe in a browser. The secret key skips all privacy rules: never share it,
# never put it in the page, and never use the production one on a laptop.
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Hosted app only, set in Vercel (Preview and Production each get their own). Leave empty on a laptop:
# npm run check-hosted uses a throwaway key when this is empty.
# 32 random bytes in base64 that encrypt resumes. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RESUME_ENCRYPTION_KEY=
# Any long random string; Vercel's daily job sends it to /api/refresh-postings, and other callers are refused.
CRON_SECRET=
