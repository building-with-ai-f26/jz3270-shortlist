{
  "name": "shortlist",
  "version": "0.2.0",
  "description": "Checks the job boards of companies on your list, drops roles you can't get, and ranks the rest against your resume.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
    "scan": "node scripts/run.js",
    "discover": "node scripts/discover.js",
    "check": "node scripts/check-sources.js",
    "build-starter": "node scripts/build-starter.js",
    "explore": "node scripts/explore.js",
    "accuracy": "node scripts/accuracy.js",
    "compare-models": "node scripts/compare-models.js",
    "check-rls": "node scripts/check-rls.js",
    "check-hosted": "node scripts/check-hosted.js",
    "check-secrets": "node scripts/check-secrets.js",
    "dev-site": "node scripts/dev-site.js",
    "refresh-postings": "node scripts/refresh-postings.js",
    "build-demo": "node scripts/build-demo.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1"
  }
}
